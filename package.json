{
  "name": "clash-of-pens",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "ClashOfPens - Physics-Based Pen Fighting Game",
  "author": "ClashOfPens Team",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:web": "vite build",
    "build:android:sync": "npm run build:web && cap sync android",
    "build:android:debug": "npm run build:android:sync && cd android && ./gradlew assembleDebug",
    "build:android:release": "npm run build:android:sync && cd android && ./gradlew assembleRelease",
    "build:android:aab": "npm run build:android:sync && cd android && ./gradlew bundleRelease",
    "build:desktop:linux": "npm run build:web && electron-builder --linux",
    "build:desktop:linux:x64": "npm run build:web && electron-builder --linux --x64",
    "build:desktop:win": "npm run build:web && electron-builder --win",
    "build:desktop:win:x64": "npm run build:web && electron-builder --win --x64",
    "build:desktop:win:x86": "npm run build:web && electron-builder --win --ia32",
    "build:desktop:all": "npm run build:web && electron-builder -mwl",
    "desktop:dev": "electron .",
    "preview": "vite preview",
    "clean": "rm -rf dist release-builds server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/game/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/matter-js": "^0.20.2",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "matter-js": "^0.20.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
